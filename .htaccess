# How long visitors' browsers keep each file (read by Apache hosting, e.g. cPanel).
# The page itself is always checked for changes. The CSS and JavaScript carry a ?v= number
# in index.html, so they can be kept for a year. Pictures and videos are kept for 30 days.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|svg|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Safety settings for every file. The Content-Security-Policy lets the site load only its own files,
# plus Google Fonts; if you add something from another site (an embedded YouTube film, say), add its address here.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self' mailto:; object-src 'none'; frame-ancestors 'self'"
</IfModule>

# The app manifest, so phones read it correctly.
AddType application/manifest+json .webmanifest

# The page shown for an address that doesn't exist.
ErrorDocument 404 /404.html

# Send the page, styles and scripts compressed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/manifest+json text/plain
</IfModule>
