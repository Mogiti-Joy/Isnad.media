# How long visitors' browsers keep each file (read by Netlify and Cloudflare Pages).
# The page itself is always checked for changes. The CSS and JavaScript carry a ?v= number
# in index.html, so they can be kept for a year. Pictures and videos are kept for 30 days.

/
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=2592000

# Safety settings for every file. The Content-Security-Policy lets the site load only its own files,
# plus Google Fonts; if you add something from another site (an embedded YouTube film, say), add its address here.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self' mailto:; object-src 'none'; frame-ancestors 'self'
