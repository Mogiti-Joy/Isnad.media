# How long visitors' browsers keep each file (read by Netlify and Cloudflare Pages).
# The page itself is always checked for changes. The CSS and JavaScript carry a ?v= number
# in index.html, so they can be kept for a year. Pictures and videos are kept for 30 days.

/
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=2592000
